# Copy to this repository's root .env. Add the real key manually there only.
# Never put the key in frontend/.env.local or a NEXT_PUBLIC variable.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
REQUEST_TIMEOUT_SECONDS=30.0
# Wrapper retries default to zero; SDK retries are also disabled.
MAX_RETRIES=0
# Live API compilation stays off until the owner explicitly enables it.
POLICYFORGE_ENABLE_LIVE_AI=false
# Public hosted deterministic demo: true blocks ALL compilation, including mocks,
# and requires exact HTTPS CORS origins. Leave false for normal local workflows.
POLICYFORGE_PUBLIC_DEMO=false
# Optional local evidence recording for a separately authorized test, e.g. ADV-01.
# Blank leaves normal compilation unchanged. This setting does NOT enable AI.
POLICYFORGE_LIVE_TEST_ID=
# Default private receipt directory: .local/compile-evidence/ (Git-ignored).
# POLICYFORGE_EVIDENCE_DIR=<absolute private persistent directory>
# Separate operator access code, at least 24 characters; NEVER reuse the Nebius key.
POLICYFORGE_COMPILE_TOKEN=
# Process-local hard attempt cap, clamped to 1..10; failures consume it too.
POLICYFORGE_AI_REQUEST_BUDGET=3
POLICYFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
