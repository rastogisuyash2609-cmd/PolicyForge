# Render Static Site build environment. Replace only the public API hostname.
NODE_VERSION=22.x
SKIP_INSTALL_DEPS=true
POLICYFORGE_STATIC_EXPORT=true
NEXT_PUBLIC_API_URL=https://REPLACE-WITH-BACKEND.onrender.com
# Leave POLICYFORGE_TEST_BUILD_DIR unset. Publish directory is out.
# No secret belongs in this file or in the static site's environment.
