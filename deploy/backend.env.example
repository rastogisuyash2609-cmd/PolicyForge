# Render backend environment, repository root. NOT a copy of the local .env.
# Public deterministic release: do not configure Nebius or workspace credentials.
PYTHONPATH=backend
POLICYFORGE_PUBLIC_DEMO=true
POLICYFORGE_ENABLE_LIVE_AI=false
POLICYFORGE_AI_REQUEST_BUDGET=1
POLICYFORGE_LIVE_TEST_ID=
POLICYFORGE_EVIDENCE_DIR=/var/data/policyforge/evidence
POLICYFORGE_CORS_ORIGINS=https://REPLACE-WITH-FRONTEND.onrender.com
MAX_RETRIES=0
REQUEST_TIMEOUT_SECONDS=30.0
# Model is nonsecret; it remains unused in public demo mode.
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# OMIT NEBIUS_API_KEY and POLICYFORGE_COMPILE_TOKEN from this public host.
